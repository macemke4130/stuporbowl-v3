<div id="private-route" data-user-is-authorized="false">
  <script is:inline>
    const privateRouteElement = document.querySelector("#private-route");

    (async () => {
      const tokenIsValid = await validateToken();

      if (!tokenIsValid) {
        localStorage.removeItem("token");
        window.location.replace("/login");
        return;
      }

      privateRouteElement.setAttribute("data-user-is-authorized", "true");
      document.documentElement.setAttribute("data-user-logged-in", "true");

      checkPermissions(localStorage.getItem("permissions"));
    })();
  </script>
  <slot />
</div>

<style>
  [data-user-is-authorized="false"] {
    display: none;
  }
</style>
