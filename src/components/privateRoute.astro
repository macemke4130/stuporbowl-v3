<div id="private-route">
  <script is:inline>
    (async () => {
      const tokenIsValid = await validateToken();

      if (!tokenIsValid) {
        localStorage.removeItem("token");
        window.location.replace("/login");
        return;
      }

      document.documentElement.setAttribute("data-user-logged-in", "true");
      checkPermissions(localStorage.getItem("permissions"));
    })();
  </script>
  <slot />
</div>

<style>
  html[data-user-logged-in=""] {
    display: none;
  }
</style>
