---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import Dialog from "../../components/Dialog.astro";

import billy from "../../../public/images/lake-billy-16-9-d.webp";
---

<Layout>
  <Hero background={billy}>
    <h1>Register for Stupor Bowl 28</h1>
  </Hero>
  <div id="form-success" class="display-none">
    <h1>Thank you for registering!</h1>
    <p>Your racer number is</p>
    <div id="racer-number"></div>
    <p>Please keep this number for race day.</p>
  </div>
  <div id="form-columns" class="page-inline-size">
    <div id="text-container">
      <div id="text-wrapper">
        <p>
          Please make sure you understand Stupor Bowl's <a href="/code-of-conduct.html">code of conduct</a> before registering. We have a zero tolerance policy for
          assholes.
        </p>
        <p>Race fee is $25. We prefer Venmo but also accept cash on race day. You'll get Venmo information after filling out this form. Race fee includes:</p>
        <ul>
          <li>T-Shirt</li>
          <li>Koozie</li>
          <li>Spoke card</li>
          <li>Manifest</li>
          <li>Your best race all year</li>
        </ul>
        <p>All fields are required.</p>
      </div>
    </div>
    <div id="form-wrapper">
      <form id="registration" aria-labelledby="page-title">
        <label>
          <span>Name</span>
          <input id="fullname" name="name" type="text" autocomplete="on" required />
        </label>
        <label>
          <span>Email Address</span>
          <input id="email" name="email" type="email" inputmode="email" autocomplete="on" required />
        </label>
        <label>
          <span>Pronouns</span>
          <input id="pronouns" name="pronouns" type="text" autocomplete="on" required />
        </label>
        <label>
          <span>Birthday</span>
          <input id="birthdate" name="birthday" type="date" required />
        </label>
        <fieldset>
          <legend>Twin Cities Local?</legend>
          <div class="radio-group">
            <label> <span>Yes</span><input type="radio" name="twin_cities_local" value="true" class="" required /> </label>
            <label> <span>No</span><input type="radio" name="twin_cities_local" value="false" class="" /> </label>
          </div>
          <label id="origin-city-container" class="display-none">
            <span>What city are you from?</span>
            <input name="origin_city" type="text" />
          </label>
        </fieldset>
        <fieldset>
          <legend>Bike Type</legend>
          <div class="radio-group-description">You can change this later. Electric assist bikes are not eligible for podiums.</div>
          <div class="radio-group">
            <label>
              <span>Fixed Gear</span>
              <input type="radio" name="bike_type" value="fixed" required />
            </label>
            <label>
              <span>Single Speed</span>
              <input type="radio" name="bike_type" value="single-speed" />
            </label>
            <label>
              <span>Multi Speed</span>
              <input type="radio" name="bike_type" value="geared" />
            </label>
            <label>
              <span>Electric Assist</span>
              <input type="radio" name="bike_type" value="electric" />
            </label>
          </div>
        </fieldset>
        <fieldset>
          <legend>Race Type</legend>
          <div class="radio-group">
            <label>
              <span>Stupor</span>
              <input type="radio" name="race_type" value="stupor" required />
            </label>
            <label>
              <span>Speed</span>
              <input type="radio" name="race_type" value="speed" />
            </label>
          </div>
          <div class="field-learn-more-container">
            <button id="type-explainer-button" type="button" class="learn-more">Learn more <span class="sr-only">about race types</span></button>
          </div>
        </fieldset>
        <fieldset>
          <legend>Gender Category</legend>
          <div class="radio-group">
            <label>
              <span>Trans and <br />Gender Non Conforming</span>
              <input type="radio" name="gender_category" value="trans" />
            </label>
            <label>
              <span>Women</span>
              <input type="radio" name="gender_category" value="women" />
            </label>
            <label>
              <span>Open</span>
              <input type="radio" name="gender_category" value="open" required />
            </label>
          </div>
        </fieldset>
        <fieldset>
          <legend>Shirt Size</legend>
          <div class="radio-group">
            <label>
              <span>Extra Small</span>
              <input type="radio" name="shirt_size" value="extra-small" />
            </label>
            <label>
              <span>Small</span>
              <input type="radio" name="shirt_size" value="small" />
            </label>
            <label>
              <span>Medium</span>
              <input type="radio" name="shirt_size" value="medium" required />
            </label>
            <label>
              <span>Large</span>
              <input type="radio" name="shirt_size" value="large" required />
            </label>
            <label>
              <span>Extra Large</span>
              <input type="radio" name="shirt_size" value="extra-large" required />
            </label>
          </div>
        </fieldset>
        <fieldset>
          <legend>Payment</legend>
          <div class="radio-group">
            <label>
              <span>Venmo</span>
              <input type="radio" name="payment_method" value="venmo" />
            </label>
            <label>
              <span>Cash</span>
              <input type="radio" name="payment_method" value="cash" />
            </label>
          </div>
        </fieldset>
        <label>
          <span>I have read and agree to the terms laid out in the <a href="/articles/waiver">waiver.</a></span>
          <input id="waiver-consent" name="racer_has_signed_waiver" type="checkbox" required />
        </label>
        <button id="registration-submit" type="submit">Register</button>
      </form>
    </div>
  </div>
  <Dialog id="race-type-dialog">
    <div class="text-container">
      <h2>Stupor Bowl Race Types</h2>
      <dl>
        <dt>Stupor</dt>
        <dd>
          Usually has 8 to 10 checkpoint stops. In order to get your manifest stamped, you must finish a drink and show your empty drink to the checkpoint
          volunteers.
        </dd>
        <dt>Speed</dt>
        <dd>
          Usually has all of the checkpoint stops in the Stupor race, plus 2 - 4 additional checkpoint stops. This race does not require drinking to get your
          manifest stamped.
        </dd>
      </dl>
    </div>
  </Dialog>
</Layout>

<script is:inline>
  const formColumnsElement = document.querySelector("#form-columns");
  const formSuccessElement = document.querySelector("#form-success");
  const registrationForm = document.querySelector("#registration");
  const submitRegistrationButton = document.querySelector("#registration-submit");
  const racerNumberElement = document.querySelector("#racer-number");
  const twinCitiesLocalRadioGroup = document.querySelectorAll(`[name="twin_cities_local"]`);
  const originCityInput = document.querySelector(`[name="origin_city"]`);
  const originCityContainer = document.querySelector("#origin-city-container");
  const raceTypeButton = document.querySelector("#type-explainer-button");
  const raceTypeDialog = document.querySelector("#race-type-dialog");

  const handleRaceTypeButtonClick = () => {
    raceTypeDialog.showModal();
  };

  const handleRacerOriginInput = (event) => {
    const target = event.currentTarget;

    if (target.getAttribute("value") === "true") {
      originCityContainer.classList.add("display-none");
    } else {
      originCityInput.setAttribute("value", "");
      originCityContainer.classList.remove("display-none");
    }
  };

  const displaySuccessPage = (racerNumber) => {
    racerNumberElement.innerText = racerNumber;
    formColumnsElement.classList.add("display-none");
    formSuccessElement.classList.remove("display-none");
  };

  const newRegistrationAttempt = async (data) => {
    const request = await api("registrations/2027", "POST", data);

    if (request.status === 200) {
      displaySuccessPage(request.data.racer_number);
    } else {
      // Show error message
    }
  };

  const handleFormSubmit = (event) => {
    event.preventDefault();

    submitRegistrationButton.setAttribute("disabled", "");

    const formElement = event.target;
    const formData = new FormData(formElement);
    const dataFromClient = Object.fromEntries(formData.entries());

    const dataForServer = {
      ...dataFromClient,
      twin_cities_local: dataFromClient.twin_cities_local === "true",
      racer_has_signed_waiver: dataFromClient.racer_has_signed_waiver === "on",
    };

    newRegistrationAttempt(dataForServer);
  };

  registrationForm.addEventListener("submit", handleFormSubmit);
  raceTypeButton.addEventListener("click", handleRaceTypeButtonClick);
  twinCitiesLocalRadioGroup.forEach((option) => option.addEventListener("input", handleRacerOriginInput));
</script>

<style>
  #form-columns {
    --form-padding: 1.5rem;
    --legend-bump: 0.25rem;

    @media (min-width: 992px) {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }

    label:has(:is(input[type="text"], input[type="email"], input[type="date"]):not(fieldset input)) {
      margin-block-end: var(--form-padding);
    }

    #text-container {
      padding-block-end: 1rem;
    }

    label,
    legend {
      font-size: 1.25rem;
    }

    fieldset {
      margin-block: var(--form-padding);
      padding-block: calc(var(--form-padding) * 0.6);
      padding-inline: calc(var(--form-padding) * 0.6);

      label:has(:is(input[type="text"], input[type="email"], input[type="date"])) {
        margin-block-start: var(--form-padding);
      }

      legend {
        padding-inline: 0.3rem;
        transform: translateY(calc(var(--legend-bump) * -1));
        margin-block: calc(var(--legend-bump) * -1);
      }

      .radio-group-description {
        margin-block-end: var(--form-padding);
      }

      .field-learn-more-container {
        margin-block-start: 1rem;
        display: flex;
        justify-content: end;

        .learn-more {
          font-size: 0.8em;
        }
      }

      .radio-group {
        --radio-group-gap: 1.5rem;

        display: flex;
        align-items: end;
        flex-wrap: wrap;
        column-gap: var(--radio-group-gap);
        row-gap: calc(var(--radio-group-gap) * 0.9);
        margin-block-end: calc(var(--radio-group-gap) * 0.3);
        margin-block-start: calc(var(--radio-group-gap) * -0.1);

        label {
          display: block;
          white-space: nowrap;
          border: 2px solid var(--site-text-color);
          position: relative;
          border-radius: var(--round);
          padding-inline: 1rem;
          padding-block: 0.5rem;
          font-size: 1.25rem;

          &:has(> input:checked) {
            background-color: var(--site-accent-color);
            color: var(--site-accent-color-text);
            border-color: transparent;
            outline: 4px dotted var(--site-text-color);
            outline-offset: 3px;
          }

          input[type="radio"] {
            opacity: 0;
            position: absolute;
            inset: 0;
          }
        }
      }
    }

    .label-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    input,
    select {
      margin-block-start: 0.15rem;
    }
  }
</style>
