---
import PrivateRoute from "../../components/privateRoute.astro";
import Layout from "../../layouts/Layout.astro";
---

<Layout>
  <PrivateRoute>
    <form id="new-post">
      <label for="post-title">Title</label>
      <input id="post-title" type="text" />
      <label for="post-content">Content</label>
      <textarea id="post-content"></textarea>
      <button id="new-post-button" type="submit">Submit</button>
    </form>
  </PrivateRoute>
</Layout>

<script is:inline>
  const newPostForm = document.querySelector("#new-post");
  const newPostButton = document.querySelector("#new-post-button");

  const newPostAttempt = async (title, content, posted_by) => {
    return await api("admin/new-post", "POST", { title, content, posted_by });
  };

  const handleFormSubmit = async (event) => {
    // Prevent HTTP request.
    event.preventDefault();

    newPostButton.textContent = "Loading...";
    newPostButton.setAttribute("disabled", "");

    const request = await newPostAttempt(
      document.querySelector("#post-title").value,
      document.querySelector("#post-content").value,
      localStorage.getItem("id"),
    );

    if (request.data === null) {
      showPostFailure();
      return;
    }
  };

  newPostForm.addEventListener("submit", handleFormSubmit);
</script>
