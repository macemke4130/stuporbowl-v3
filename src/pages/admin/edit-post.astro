---
import PrivateRoute from "../../components/privateRoute.astro";
import Layout from "../../layouts/Layout.astro";
---

<Layout>
  <PrivateRoute>
    <form id="edit-post">
      <label for="post-title">Title</label>
      <input id="post-title" type="text" />
      <label for="post-content">Content</label>
      <textarea id="post-content"></textarea>
      <button id="edit-post-button" type="submit">Submit</button>
    </form>
  </PrivateRoute>
</Layout>

<script is:inline>
  const url = new URL(window.location.href);
  const params = url.searchParams;
  const postId = params.get("id");

  const titleElement = document.querySelector("#post-title");
  const contentElement = document.querySelector("#post-content");
  const editForm = document.querySelector("#edit-post");

  const getPost = async (postId) => {
    return await api(`post/${postId}`);
  };

  const updatePost = async (postId) => {
    const request = await api("admin/edit-post", "POST", {
      title: titleElement.value,
      content: contentElement.value,
      postId,
    });

    if (request.status === 401) {
      showMessage("unauthorized");
    }
  };

  const fillForm = (post) => {
    titleElement.value = post.title;
    contentElement.value = post.content;
  };

  const handleFormSubmit = (event) => {
    event.preventDefault();

    updatePost(postId);
  };

  editForm.addEventListener("submit", handleFormSubmit);

  (async () => {
    const postContent = await getPost(postId);
    fillForm(postContent);
  })();
</script>
