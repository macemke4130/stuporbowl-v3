---
import Image from "astro/components/Image.astro";
import Hero from "../../components/Hero.astro";
import Layout from "../../layouts/Layout.astro";
import heroBackground from "./stupor-bowl-27/images/2026-mace-35.webp";

import imageYear1 from "./stupor-bowl-1/images/card.jpg";
import imageYear2 from "./stupor-bowl-2/images/flyer.jpg";
import imageYear3 from "./stupor-bowl-3/images/manifest-front.jpg";
import imageYear4 from "./stupor-bowl-4/images/flyer.jpg";
import imageYear8 from "./stupor-bowl-8/images/flyer.jpg";
import imageYear10 from "./stupor-bowl-10/images/lineup.jpg";

const years = [
  {
    date: "January 24, 1998",
    number: 1,
    image: imageYear1,
  },
  {
    date: "January 30, 1999",
    image: imageYear2,
  },
  {
    date: "January 29, 2000",
    image: imageYear3,
  },
  {
    date: "January 27, 2001",
    image: imageYear4,
  },
  {
    date: "February 2, 2002",
  },
  {
    date: "January 25, 2003",
  },
  {
    date: "January 31, 2004",
  },
  {
    date: "February 5, 2005",
    image: imageYear8,
  },
  {
    date: "February 4, 2006",
  },
  {
    date: "February 3, 2007",
    image: imageYear10,
  },
  {
    date: "February 2, 2008",
  },
  {
    date: "January 31, 2009",
  },
  {
    date: "February 6, 2010",
  },
  {
    date: "February 5, 2011",
  },
  {
    date: "February 4, 2012",
  },
  {
    date: "February 2, 2013",
    number: 16,
  },
  {
    date: "February 1, 2014",
  },
  {
    date: "January 31, 2015",
  },
  {
    date: "February 6, 2016",
  },
  {
    date: "February 4, 2017",
  },
  {
    date: "February 3, 2018",
    number: 21,
  },
  {
    date: "February 2, 2019",
    number: 22,
  },
  {
    date: "February 1, 2020",
    number: 23,
  },
  {
    date: "February 11, 2023",
    title: "Stupor Bowl Lite",
    number: 24,
  },
  {
    date: "February 10, 2024",
    number: 25,
  },
  {
    date: "February 8, 2025",
    number: 26,
  },
  {
    date: "February 7, 2026",
    number: 27,
  },
];
---

<Layout>
  <Hero background={heroBackground}>
    <h1>Stupor Bowl Archive</h1>
  </Hero>
  <section aria-label="Archive list" class="page-inline-size">
    <div id="archive-list" role="list">
      {
        years.map((year, index) => {
          const eventCount = index + 1;
          const cardImage = year.image;

          return (
            <div role="listitem">
              <a href={`./archive/stupor-bowl-${eventCount}`} class="year-link">
                <div role="group" aria-label={`Stupor Bowl ${eventCount}`} class="year-card">
                  <div class="image-container">
                    {cardImage ? (
                      <Image src={cardImage} width={350} height={350} alt="" class="card-image" loading="lazy" fetchpriority="auto" />
                    ) : (
                      <div class="missing-card-image" />
                    )}
                  </div>
                  <div class="text-container">
                    <h2>Stupor Bowl {eventCount}</h2>
                    <date>{year.date}</date>
                  </div>
                </div>
              </a>
            </div>
          );
        })
      }
    </div>
  </section>
</Layout>

<style>
  #archive-list {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 2rem;

    @media (min-width: 992px) {
      grid-template-columns: repeat(3, 1fr);
    }

    .year-link {
      text-decoration: none;
    }

    .year-card {
      --card-block-size: 12rem;
      display: grid;
      place-items: center;

      block-size: var(--card-block-size);
      border: 1px solid #eee3;
      border-radius: 0.5rem;
      overflow: hidden;
      text-align: center;
      background: var(--card-background-color);

      @media (min-width: 992px) {
        --card-block-size: 8rem;
      }

      & > * {
        grid-area: 1 / -1;
      }

      .image-container {
        position: relative;
        inline-size: 100%;
        align-self: start;

        &::after {
          content: "";
          position: absolute;
          inset-inline: 0;
          inset-block-end: 0;
          block-size: calc(var(--card-block-size) * 0.8);
          background: linear-gradient(transparent, var(--card-background-color));
        }
      }

      .card-image,
      .missing-card-image {
        inline-size: 100%;
        object-fit: cover;
        block-size: calc(var(--card-block-size) * 0.7);
      }

      .missing-card-image {
        background: radial-gradient(#ddd, #aaa);

        &::before {
          content: "No image yet!";
          color: var(--card-background-color);
          font-size: 80%;
        }
      }

      .text-container {
        align-self: end;
        z-index: 1;
        padding-block-end: 0.5rem;
        -webkit-text-stroke: 1px black;
        paint-order: stroke;

        h2 {
          font-size: 1.5rem;
        }
      }
    }
  }
</style>
