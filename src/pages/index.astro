---
import Layout from "../layouts/Layout.astro";
import TextHero from "../components/TextHero.astro";
import Image from "astro/components/Image.astro";
import billy from "../../public/images/lake-billy-16-9-d.webp";
---

<Layout>
  <div class="pile">
    <div class="background-container">
      <Image
        src={billy}
        width={2342}
        height={1317}
        widths={[350, 768, 992, 1200, 1440, 2000, 3000]}
        sizes="(min-width: 992px) 100vw, 992px"
        alt=""
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <TextHero>
      <div class="h1">
        <h1>Stupor Bowl</h1><wbr />
        <span> 28</span>
      </div>
      <h2><time datetime="2027-02-13">Saturday, February 13th 2027</time></h2>
      <div class="location">Minneapolis, Minnesota</div>
    </TextHero>
  </div>
</Layout>

<style is:inline>
  .pile {
    display: grid;
    place-items: center;

    & > * {
      grid-area: 1 / -1;
    }

    .background-container {
      position: relative;

      &::after {
        content: "";
        position: absolute;
        inset-inline: 0;
        inset-block-start: 80%;
        inset-block-end: 0;
        background: linear-gradient(transparent, var(--site-background-color));
      }

      img {
        opacity: 0.1;
        inline-size: 100vw;
        block-size: calc(100vh - var(--footer-block-size));
        object-fit: cover;
        object-position: 60%;
      }
    }
  }
  .text-hero {
    filter: drop-shadow(2px 2px 2px #000);

    time {
      font-size: clamp(1.25rem, 6vw, 2.5rem);
    }

    .location {
      font-size: clamp(1.25rem, 4vw, 2.25rem);
    }
  }

  .h1 {
    font-size: clamp(1rem, 12vw, 4rem);
    font-weight: bold;

    h1 {
      font-size: inherit;
      display: inline-block;
    }
  }

  h2 {
    font-size: 2rem;
    font-weight: normal;
  }
</style>
