---
import Layout from "../layouts/Layout.astro";
import TextHero from "../components/TextHero.astro";
---

<Layout>
  <!-- Temp Homepage -->
  <TextHero>
    <div class="h1">
      <h1>Stupor Bowl</h1><wbr />
      <span> 28</span>
    </div>
    <h2><time datetime="2027-02-13">Saturday, February 13th 2027</time></h2>
    <div class="location">Minneapolis, Minnesota</div>
  </TextHero>
  <section aria-labelledby="posts-title">
    <h2 id="posts-title">Latest News</h2>
    <div id="posts-container">Loading news...</div>
  </section>
</Layout>

<style is:inline>
  #posts-container {
    article {
      padding-inline: 0.5rem;
      margin-block-end: 2rem;

      h2 {
        font-size: 1.25rem;
      }
    }
  }

  .text-hero {
    time {
      font-size: clamp(1.25rem, 6vw, 2.5rem);
    }

    .location {
      font-size: clamp(1.25rem, 4vw, 2.25rem);
    }
  }

  .h1 {
    font-size: clamp(1rem, 12vw, 4rem);
    font-weight: bold;

    h1 {
      font-size: inherit;
      display: inline-block;
    }
  }

  h2 {
    font-size: 2rem;
    font-weight: normal;
  }
</style>

<script is:inline>
  const getPosts = async () => {
    return await api("posts");
  };

  const buildPosts = (posts) => {
    const postsContainer = document.querySelector("#posts-container");
    postsContainer.innerText = "";

    for (const post of posts) {
      const articleElement = document.createElement("article");
      articleElement.innerHTML = `
        <h2>${post.title}</h2>
        <address>Posted by ${post.display_name}</address>
        <time>${post.datePosted}</time>
        <div class="post-content">
          ${post.content}
        </div>
      `;

      postsContainer.appendChild(articleElement);
    }
  };

  (async () => {
    const allPosts = await getPosts();
    console.log(allPosts);
    buildPosts(allPosts);
  })();
</script>
