<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      const env = window.location.hostname.includes("localhost") ? "http://localhost:3004" : "";

      const api = async (apiPath, method = "GET", body) => {
        try {
          const headers = { "Content-Type": "application/json", Accept: "application/json" };
          const request = await fetch(`${env}/api/${apiPath}`, {
            method,
            headers,
            body: JSON.stringify(body),
          });
          const response = await request.json();
          return response;
        } catch (e) {
          console.error(e);
        }
      };
    </script>
    <title>Stupor Bowl</title>
  </head>
  <body>
    <header>
      <div id="site-title">Stupor Bowl</div>
      <nav>
        <div role="list">
          <div role="listitem">
            <a href="/login">Admin Login</a>
          </div>
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>Copyright Stupor Bowl MPLS |<wbr /> 1998 until forever</footer>
  </body>
</html>

<style is:global>
