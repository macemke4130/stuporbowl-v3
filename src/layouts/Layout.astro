      cursor: default;
    }

    :where(header) {
      border-block-end: 1px solid var(--primary-button-color);
    }

    :where(footer) {
      block-size: 6rem;
      align-content: center;
      border-block-start: 1px solid var(--primary-button-color);
      text-align: center;
    }

    :where(a) {
      /* Fallback for color-mix() */
      text-decoration-color: #fff5;
      text-decoration-color: color-mix(in srgb, currentColor, transparent 50%);
      text-underline-offset: 2px;
    }
  }

  @layer components {
    sb-hero {
      block-size: 50rem;
    }

    a.button {
      text-align: center;
      text-decoration: none;
      text-wrap: balance;
      font-weight: bold;
      display: block;
      inline-size: fit-content;
      padding-inline: 2rem;
      padding-block: 1.5rem;
      border-radius: 1rem;
      color: var(--site-text-color);
      border: 2px solid var(--site-text-color);
      background-color: var(--primary-button-color);
      margin-inline: auto;
      margin-block: 1.5rem;
      max-inline-size: 18rem;
    }
  }

  @layer utilities {
    .flex {
      display: flex;
    }

    .justify-content-center {
      justify-content: center;
    }

    .align-items-center {
      align-items: center;
    }

    .jake-blaze-filter {
      filter: blur(5px);
    }
  }

  @layer overrides {
